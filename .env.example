# CareBridge Environment Variables
# Copy this file to .env.local and fill in your values.
#
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: anything prefixed VITE_ is inlined into the browser bundle by Vite
# and is therefore PUBLIC. Never put a secret API key behind a VITE_ prefix.
# Provider secrets belong in the server-side variables further down, which are
# read only by the serverless functions in api/.
# ─────────────────────────────────────────────────────────────────────────────


# ── Client (public — shipped in the bundle) ─────────────────────────────────

# Supabase project (Project Settings → API at https://supabase.com/dashboard).
# The anon key is designed to be public; access is governed by RLS policies.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: custom sync backend. Leave blank to sync directly against Supabase.
VITE_SYNC_API_URL=

# Web Push (read by src/services/webPushService.ts).
# This is the VAPID *public* key only. Generate a pair with:
#   npx web-push generate-vapid-keys
# Store BOTH halves in the `app_secrets` table (keys 'vapid_public_key' and
# 'vapid_private_key') — that is what the send-push-notification edge function
# reads. Leave blank to disable push notifications.
VITE_VAPID_PUBLIC_KEY=


# ── Server-side only (never exposed to the browser) ─────────────────────────
# Set these on the host (e.g. Vercel → Project Settings → Environment
# Variables). They are read by api/ai-chat.js and api/ai-vision.js, which proxy
# AI requests so the keys stay off the client. All are optional: OCR falls back
# to Tesseract.js, which runs offline with no key, and the AI features degrade
# gracefully when a provider is unconfigured.

# OpenAI — powers /api/ai-chat (chat completions) and /api/ai-vision (document
# OCR plus the WoundProgress vision enrichment).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic — optional alternative provider for /api/ai-chat.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Cloud Vision — optional alternative OCR engine for /api/ai-vision.
# https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_VISION_API_KEY=


# ── Supabase edge function (set with `supabase secrets set`) ────────────────
# Used by supabase/functions/send-push-notification. SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY are injected by the platform automatically.

# Contact address embedded in the VAPID JWT sent to push services.
VAPID_SUBJECT=mailto:support@carebridge.com
